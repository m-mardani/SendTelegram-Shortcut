[Unit]
Description=hold2tg — hold a hotkey to send the selection to Telegram
Documentation=file://%h/.local/share/hold2tg/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/hold2tg run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
